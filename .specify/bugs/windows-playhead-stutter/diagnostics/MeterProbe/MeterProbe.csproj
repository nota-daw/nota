<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <NotaBinaries>$(MSBuildThisFileDirectory)..\..\..\..\..\src\managed\Nota.App\bin\Release\net10.0</NotaBinaries>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(NotaBinaries)\*.dll" Exclude="$(NotaBinaries)\nota_engine.dll" />
    <None Include="$(NotaBinaries)\nota_engine.dll;$(NotaBinaries)\runtimes\win-x64\native\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
