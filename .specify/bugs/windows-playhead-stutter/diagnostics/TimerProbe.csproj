<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <NotaBinaries>$(MSBuildThisFileDirectory)..\..\..\..\src\managed\Nota.App\bin\Release\net10.0</NotaBinaries>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(NotaBinaries)\Avalonia*.dll" />
    <Reference Include="$(NotaBinaries)\SkiaSharp.dll" />
    <Reference Include="$(NotaBinaries)\HarfBuzzSharp.dll" />
    <None Include="$(NotaBinaries)\runtimes\win-x64\native\*.dll"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\..\..\..\src\managed\Nota.App\AvaloniaPeriodicTimer.cs"
             Link="AvaloniaPeriodicTimer.cs" />
    <Compile Include="..\..\..\..\src\managed\Nota.Application\Ports\IPeriodicTimer.cs"
             Link="IPeriodicTimer.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
