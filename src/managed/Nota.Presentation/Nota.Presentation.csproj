<!-- Presentation layer: ViewModels (CommunityToolkit.Mvvm). Depends on Application + Domain.
     Must not reference Infrastructure or Avalonia views. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nota.Application\Nota.Application.csproj" />
    <ProjectReference Include="..\Nota.Domain\Nota.Domain.csproj" />
  </ItemGroup>

</Project>
