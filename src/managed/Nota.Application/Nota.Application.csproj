<!-- Application layer: use-cases and ports (interfaces). Depends only on Domain. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nota.Domain\Nota.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The English reference (spec 077): every interface text by key. Embedded beside Loc so
         English is there before a language is installed and in every project using Loc. -->
    <EmbeddedResource Include="Localization\en.json" LogicalName="Nota.Localization.en.json" />
  </ItemGroup>

</Project>
