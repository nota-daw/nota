<!-- Nota Remote: serves the phone controller (a small PWA, built from src/web/remote) over the
     local network and keeps a WebSocket with every paired phone. Kept free of Avalonia like
     Nota.Mcp — the UI-thread side (transport view-model, MIDI Learn, refresh) is injected
     through IRemoteHost, implemented by Nota.App. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nota.Application\Nota.Application.csproj" />
  </ItemGroup>

  <!-- The phone app. `npm run build` in src/web/remote writes into wwwroot/; the files are
       embedded so the app ships as one assembly and needs no web root on disk. The build
       runs when its sources are newer than the output (and node is available); a checkout
       without node still builds and serves a page saying the controller wasn't built. -->
  <PropertyGroup>
    <RemoteWebDir>$(MSBuildProjectDirectory)/../../web/remote</RemoteWebDir>
    <RemoteWwwRoot>$(MSBuildProjectDirectory)/wwwroot</RemoteWwwRoot>
  </PropertyGroup>
  <ItemGroup>
    <RemoteWebSources Include="$(RemoteWebDir)/src/**/*;$(RemoteWebDir)/public/**/*;$(RemoteWebDir)/index.html;$(RemoteWebDir)/package.json;$(RemoteWebDir)/vite.config.ts" />
  </ItemGroup>
  <Target Name="BuildRemoteWeb" Inputs="@(RemoteWebSources)" Outputs="$(RemoteWwwRoot)/index.html"
          Condition="Exists('$(RemoteWebDir)/package.json') and '$(NotaSkipWebBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="node --version" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="NodeExit" />
    </Exec>
    <Warning Condition="'$(NodeExit)' != '0'" Text="Node.js not found: the Nota Remote phone page is not built (install Node 20+ and rebuild)." />
    <Exec Condition="'$(NodeExit)' == '0' and !Exists('$(RemoteWebDir)/node_modules')" WorkingDirectory="$(RemoteWebDir)" Command="npm ci --no-audit --no-fund" />
    <Exec Condition="'$(NodeExit)' == '0'" WorkingDirectory="$(RemoteWebDir)" Command="npm run build" />
  </Target>
  <Target Name="EmbedRemoteWeb" BeforeTargets="BeforeBuild" DependsOnTargets="BuildRemoteWeb">
    <ItemGroup>
      <_RemoteWeb Include="$(RemoteWwwRoot)/**/*" />
      <EmbeddedResource Include="@(_RemoteWeb)" LogicalName="wwwroot/%(_RemoteWeb.RecursiveDir)%(_RemoteWeb.Filename)%(_RemoteWeb.Extension)" />
    </ItemGroup>
  </Target>

</Project>
