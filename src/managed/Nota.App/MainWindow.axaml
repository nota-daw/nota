<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:Nota.App"
        xmlns:vm="clr-namespace:Nota.Presentation;assembly=Nota.Presentation"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
        x:Class="Nota.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200" Height="800" MinWidth="1100" MinHeight="680"
        Background="{DynamicResource Brush.BgApp}"
        Icon="/Assets/logo.png"
        WindowState="Maximized"
        Title="Nota">
  <Window.Resources>
    <app:ToolbarSideToAlignmentConverter x:Key="ToolbarSideToAlignment"/>
  </Window.Resources>
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="New" Click="OnMenuNew" Gesture="Cmd+N"/>
            <NativeMenuItem Header="Open…" Click="OnMenuOpen" Gesture="Cmd+O"/>
            <NativeMenuItem Header="Save" Click="OnMenuSave" Gesture="Cmd+S"/>
            <NativeMenuItem Header="Save As…" Click="OnMenuSaveAs" Gesture="Shift+Cmd+S"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Import audio…" Click="OnMenuImport" Gesture="Cmd+I"/>
            <NativeMenuItem Header="Export audio…" Click="OnMenuExport" Gesture="Shift+Cmd+E"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Settings…" Click="OnPreferences" Gesture="Ctrl+,"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="Edit">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Undo" Click="OnMenuUndo" Gesture="Cmd+Z"/>
            <NativeMenuItem Header="Redo" Click="OnMenuRedo" Gesture="Shift+Cmd+Z"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Duplicate clip" Click="OnMenuDuplicate" Gesture="Cmd+D"/>
            <NativeMenuItem Header="Split at playhead" Click="OnMenuSplit" Gesture="Cmd+E"/>
            <NativeMenuItem Header="Consolidate" Click="OnMenuConsolidate" Gesture="Cmd+J"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Lock Envelopes" Click="OnToggleLockEnvelopes" ToggleType="CheckBox"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Cut" Click="OnMenuCut"/>
            <NativeMenuItem Header="Copy" Click="OnMenuCopy"/>
            <NativeMenuItem Header="Paste" Click="OnMenuPaste"/>
            <NativeMenuItem Header="Delete" Click="OnMenuDeleteSel"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Mixer" Click="OnMenuMixer" Gesture="Cmd+M"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Toggle browser" Click="OnMenuToggleBrowser"/>
            <NativeMenuItem Header="Toggle detail panel" Click="OnMenuToggleClip"/>
            <NativeMenuItem Header="Toggle overview" Click="OnMenuToggleOverview"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="Transport">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Play / Stop" Click="OnMenuPlayStop"/>
            <NativeMenuItem Header="Record" Click="OnMenuRecord"/>
            <NativeMenuItem Header="Loop" Click="OnMenuLoop" Gesture="Cmd+L"/>
            <NativeMenuItem Header="Metronome" Click="OnMenuMetronome" Gesture="Cmd+K"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="Help">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="What's New" Click="OnWhatsNew"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="About Nota" Click="OnAbout"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Panel>
  <DockPanel>
    <!-- Title bar (36) — custom frameless: macOS traffic lights sit in the left
         inset; centered doc title. Draggable. -->
    <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="36"
            Background="{DynamicResource Brush.ChromeBg}"
            BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPressed">
      <Grid x:Name="TitleBarRow" ColumnDefinitions="78,*,Auto" Margin="0,0,12,0">
        <TextBlock x:Name="DocTitleText" Grid.Column="1" Text="Nota" Classes="Caption"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.TextSecondary}"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        </StackPanel>
      </Grid>
    </Border>

    <!-- In-window menu bar for Windows/Linux (empty on macOS: menus go to the system bar) -->
    <NativeMenuBar DockPanel.Dock="Top"/>

    <!-- Transport (48): controls pinned left | CPU + master pinned right (1b) -->
    <Border DockPanel.Dock="Top" Classes="Panel" Height="48" Padding="12,0">
      <Grid ColumnDefinitions="*,Auto,*">
        <!-- Left (pinned): position · BPM · time signature · quantize -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
          <!-- Position (click to toggle bars.beats ↔ minutes:seconds) -->
          <Border Classes="well" Cursor="Hand" PointerPressed="OnTogglePositionDisplay"
                  ToolTip.Tip="Click to switch between bars and time">
            <TextBlock Classes="Mono" Text="{Binding Transport.PositionText}" FontSize="12" MinWidth="52"
                       TextAlignment="Center" Foreground="{DynamicResource Brush.AccentBright}" VerticalAlignment="Center"/>
          </Border>
          <!-- BPM (drag vertically or double-click to type) -->
          <Border Classes="well" Padding="8,0" ToolTip.Tip="Drag ↕ or double-click to set tempo">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <Panel x:Name="BpmHost" Width="40" VerticalAlignment="Stretch"/>
              <TextBlock Classes="SectionLabel" Text="BPM" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <!-- Time signature (drag ↕ each field to change) -->
          <Border Classes="well" Padding="8,0" ToolTip.Tip="Drag ↕ to set time signature">
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <Panel x:Name="TimeSigNumHost" Width="16" VerticalAlignment="Stretch"/>
              <TextBlock Classes="Mono" Text="/" FontSize="12"
                         Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center"/>
              <Panel x:Name="TimeSigDenHost" Width="16" VerticalAlignment="Stretch"/>
            </StackPanel>
          </Border>
          <!-- Launch quantize: click to cycle (None … 1/16 … 8 Bars). Applied to Session slot/scene launches. -->
          <Button x:Name="LaunchQChip" Classes="chip" Click="OnCycleLaunchQ" ToolTip.Tip="Launch quantize (Session)">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Classes="SectionLabel" Text="Q" VerticalAlignment="Center"/>
              <TextBlock x:Name="LaunchQLabel" Classes="Mono" Text="1 Bar" FontSize="10"
                         Foreground="{DynamicResource Brush.AccentBright}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Center: transport (play · stop · rec) | metronome · follow · loop -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button x:Name="PlayBtn" Classes="tp-play" Content="▶" ToolTip.Tip="Play"
                    Foreground="{DynamicResource Brush.TextOnAccent}" Command="{Binding Transport.PlayCommand}"/>
            <Button x:Name="StopBtn" Classes="tp-icon" Content="■" ToolTip.Tip="Stop"
                    Foreground="{DynamicResource Brush.TextSecondary}" Command="{Binding Transport.StopCommand}"/>
            <ToggleButton x:Name="RecordBtn" Classes="tp-icon" Content="●" ToolTip.Tip="Record"
                          Foreground="{DynamicResource Brush.Danger}" IsChecked="{Binding Transport.RecordOn}"/>
          </StackPanel>
          <Border Width="1" Height="22" Background="{DynamicResource Brush.BorderDefault}" Margin="4,0"/>
          <!-- Metronome (icon) -->
          <ToggleButton Classes="tp-icon" IsChecked="{Binding Transport.MetronomeOn}" ToolTip.Tip="Metronome">
            <Viewbox Width="15" Height="15">
              <Canvas Width="24" Height="24">
                <Path Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.7"
                      StrokeJoin="Round" Data="M12 3 L18.5 20 L5.5 20 Z"/>
                <Path Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.7"
                      StrokeLineCap="Round" Data="M12 20 L14.5 8"/>
                <Ellipse Canvas.Left="13" Canvas.Top="6.5" Width="3" Height="3"
                         Fill="{Binding $parent[ToggleButton].Foreground}"/>
              </Canvas>
            </Viewbox>
          </ToggleButton>
          <!-- Follow playhead: keep the arrangement scrolling with the cursor -->
          <ToggleButton x:Name="FollowBtn" Classes="tp-icon" Click="OnToggleFollow" ToolTip.Tip="Follow playhead">
            <Viewbox Width="15" Height="15">
              <Canvas Width="24" Height="24">
                <Path Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.8"
                      StrokeLineCap="Round" Data="M3 18 H21"/>
                <Path Fill="{Binding $parent[ToggleButton].Foreground}" Data="M8 6 H16 L12 12 Z"/>
                <Path Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.8"
                      StrokeLineCap="Round" Data="M12 12 V18"/>
              </Canvas>
            </Viewbox>
          </ToggleButton>
          <!-- Loop (icon) + range readout -->
          <ToggleButton Classes="chip" IsChecked="{Binding Transport.LoopOn}" ToolTip.Tip="Loop">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <Viewbox Width="15" Height="15">
                <Canvas Width="24" Height="24">
                  <Path Fill="{Binding $parent[ToggleButton].Foreground}"
                        Data="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z"/>
                </Canvas>
              </Viewbox>
              <TextBlock Classes="Mono" Text="{Binding Transport.LoopRangeText}" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
        </StackPanel>

        <!-- Right (pinned): MIDI-learn toggle + CPU (live DSP load) + master volume + stereo meter -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" HorizontalAlignment="Right">
          <ToggleButton x:Name="MidiLearnBtn" Classes="seg" Content="MIDI" VerticalAlignment="Center"
                        Click="OnToggleMidiLearn"
                        ToolTip.Tip="MIDI Learn — highlight mappable controls, click one, then move a knob on your controller"/>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Classes="SectionLabel" Text="CPU" VerticalAlignment="Center"/>
            <Border Width="56" Height="5" Background="{DynamicResource Brush.BgSunken}" CornerRadius="3" VerticalAlignment="Center" ClipToBounds="True">
              <Border x:Name="CpuFill" Width="0" HorizontalAlignment="Left" CornerRadius="3"
                      Background="{DynamicResource Brush.Success}"/>
            </Border>
            <TextBlock x:Name="CpuText" Classes="Mono" Text="0%" FontSize="10"
                       Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" MinWidth="26"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="SectionLabel" Text="MASTER" VerticalAlignment="Center"/>
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <Panel x:Name="MasterVolHost" Width="120" Height="12"/>
              <Panel x:Name="MasterMeterHost" Width="120" Height="6"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Toolbar (34): view switch + track adds | right: snap / automation / follow -->
    <Border DockPanel.Dock="Top" Classes="Panel" Height="34" Padding="12,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="segmented">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ToggleButton x:Name="ArrangeBtn" Classes="seg" Content="Arrangement" IsChecked="True" Click="OnShowArrangement"/>
              <ToggleButton x:Name="SessionBtn" Classes="seg" Content="Session" Click="OnShowSession"/>
              <ToggleButton x:Name="ModularBtn" Classes="seg" Content="Modular" Click="OnShowModular"/>
            </StackPanel>
          </Border>
          <Border Width="1" Height="18" Background="{DynamicResource Brush.BorderDefault}"/>
          <Button Classes="chip" Content="+ Instrument" Click="OnAddInstrumentClicked"/>
          <Button Classes="chip" Content="+ Audio" Click="OnAddAudioClicked"/>
          <Button Classes="chip" Content="+ Return" Click="OnAddReturnClicked"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="SnapChip" Classes="chip" Click="OnCycleSnap" ToolTip.Tip="Clip snap grid">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Snap" VerticalAlignment="Center"/>
              <TextBlock x:Name="SnapLabel" Classes="Mono" Text="1/4" FontSize="10"
                         Foreground="{DynamicResource Brush.AccentBright}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Border Classes="segmented">
            <ToggleButton x:Name="AutomationToggle" Classes="seg" Content="Automation"
                          Click="OnToggleAutomation" ToolTip.Tip="Show parameter-automation lanes"/>
          </Border>
          <!-- Automation record mode (M9-C): Read / Touch / Latch / Write.
               Only shown while automation editing is active. -->
          <Border x:Name="AutoModeBar" Classes="segmented" IsVisible="False" ToolTip.Tip="Automation record mode">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ToggleButton x:Name="AutoModeRead" Classes="seg" Content="Read" IsChecked="True" Click="OnAutoModeRead"/>
              <ToggleButton x:Name="AutoModeTouch" Classes="seg" Content="Touch" Click="OnAutoModeTouch"/>
              <ToggleButton x:Name="AutoModeLatch" Classes="seg" Content="Latch" Click="OnAutoModeLatch"/>
              <ToggleButton x:Name="AutoModeWrite" Classes="seg" Content="Write" Click="OnAutoModeWrite"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status bar (22) -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.ChromeBg}"
            BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="0,1,0,0"
            Height="22" Padding="12,0">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Classes="Caption" VerticalAlignment="Center" Text="{Binding StatusText}"/>
        <!-- Background-operation strip: label + thin bar, shown only while a background op runs. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="0,0,14,0"
                    IsVisible="{Binding BackgroundBusy}">
          <TextBlock Classes="Caption" VerticalAlignment="Center" Text="{Binding BackgroundLabel}"/>
          <ProgressBar Width="120" Height="4" VerticalAlignment="Center"
                       Minimum="0" Maximum="100"
                       Value="{Binding BackgroundProgress}"
                       IsIndeterminate="{Binding BackgroundIndeterminate}"
                       Foreground="{DynamicResource Brush.Accent}"
                       Background="{DynamicResource Brush.BorderDefault}"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Classes="Caption Mono"
                   VerticalAlignment="Center" Text="{Binding EngineInfo}"/>
      </Grid>
    </Border>

    <!-- Main area (fills) over a resizable bottom Detail panel, split by a
         draggable horizontal GridSplitter. -->
    <Grid x:Name="BodyGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="120"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="0"/>
      </Grid.RowDefinitions>

      <!-- Left browser (240) + main area (fills) -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="240" MinWidth="160" MaxWidth="480"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <app:BrowserView x:Name="Browser" Grid.Column="0"/>
        <GridSplitter Grid.Column="1" Width="3" Background="{DynamicResource Brush.BorderDefault}"
                      ResizeDirection="Columns"/>
        <Panel x:Name="MainContent" Grid.Column="2">
          <app:ArrangementView x:Name="Timeline"/>
        </Panel>
      </Grid>

      <!-- Drag handle to resize the Detail panel (only shown when it is open). -->
      <GridSplitter x:Name="DetailSplitter"
                    Grid.Row="1"
                    Height="3"
                    IsVisible="False"
                    HorizontalAlignment="Stretch" ResizeDirection="Rows"
                    Background="{DynamicResource Brush.BorderDefault}"/>

      <!-- Detail panel: Devices chain / Clip (piano roll) / Mixer for the selected track -->
      <Border x:Name="DetailPanel" Grid.Row="2" Classes="Panel"
              IsVisible="False" Background="{DynamicResource Brush.BgApp}">
        <DockPanel>
          <!-- Header (1d/1e): mode tabs · track chip (routing/PDC) · Freeze · close -->
          <Grid DockPanel.Dock="Top" Height="34" Margin="12,0" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <Border Classes="segmented" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <ToggleButton x:Name="DetailDevicesBtn" Classes="seg" Content="Devices" Click="OnDetailDevices"/>
                <ToggleButton x:Name="DetailClipBtn" Classes="seg" Content="Clip" IsEnabled="False"
                              ToolTip.Tip="Select a MIDI clip to edit it" Click="OnDetailClip"/>
              </StackPanel>
            </Border>
            <ContentControl x:Name="DetailChipHost" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button x:Name="FreezeBtn" Classes="ghost" Height="24" Padding="8,0" VerticalAlignment="Center"
                      Click="OnFreezeClick"
                      ToolTip.Tip="Freeze track — bounce it to audio to free up CPU (right-click for Flatten)">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock x:Name="FreezeIcon" Text="❄" FontSize="12" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.TextSecondary}"/>
                  <TextBlock x:Name="FreezeLabel" Text="Freeze" FontSize="11" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
              </Button>
              <Button x:Name="LiveFreezeBtn" Classes="ghost" Height="24" Padding="8,0" VerticalAlignment="Center"
                      IsVisible="False" Click="OnLiveFreezeClick"
                      ToolTip.Tip="Live Freeze — bounce to a linked audio track below and sleep the source (Edit later to change it)">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Path Width="14" Height="14" Stretch="None" StrokeThickness="1.4"
                        Stroke="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"
                        Data="{x:Static app:NotaIcons.ChainLink}"/>
                  <TextBlock Text="Live Freeze" FontSize="11" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
              </Button>
              <Button x:Name="EditBtn" Classes="ghost" Height="24" Padding="8,0" VerticalAlignment="Center"
                      IsVisible="False" Click="OnEditClick"
                      ToolTip.Tip="Edit the frozen source — wakes it so you can change notes/devices (right-click: Unfreeze / Flatten)">
                <TextBlock Text="✎ Edit" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.AccentBright}"/>
              </Button>
              <Button x:Name="DoneBtn" Classes="ghost" Height="24" Padding="8,0" VerticalAlignment="Center"
                      IsVisible="False" Click="OnDoneClick"
                      ToolTip.Tip="Done — re-freeze the source and put it back to sleep">
                <TextBlock Text="✓ Done" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.AccentBright}"/>
              </Button>
              <Button x:Name="DiscardBtn" Classes="ghost" Height="24" Padding="6,0" VerticalAlignment="Center"
                      IsVisible="False" Click="OnDiscardClick"
                      ToolTip.Tip="Discard — leave edit mode without re-freezing">
                <TextBlock Text="✗" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextTertiary}"/>
              </Button>
            </StackPanel>
            <Button x:Name="DetailPopOut" Grid.Column="3" Content="⧉" Classes="ghost" FontSize="14" Margin="8,0,0,0"
                    Foreground="{DynamicResource Brush.TextTertiary}" Click="OnToggleDetailWindow"
                    ToolTip.Tip="Open Devices + Clip in a separate window"/>
            <Button Grid.Column="4" Content="✕" Classes="ghost" FontSize="12" Margin="4,0,0,0"
                    Foreground="{DynamicResource Brush.TextTertiary}" Click="OnCloseDetail"/>
          </Grid>
          <ContentControl x:Name="DetailBody"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
    <!-- MIDI-learn glass: highlights mappable controls + captures the learn click. -->
    <app:MidiLearnOverlay x:Name="LearnOverlay" IsHitTestVisible="False"/>
  </Panel>
</Window>
