<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:Nota.App"
        xmlns:vm="clr-namespace:Nota.Presentation;assembly=Nota.Presentation"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
        x:Class="Nota.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200" Height="800" MinWidth="1100" MinHeight="680"
        Background="{DynamicResource Brush.BgApp}"
        Icon="/Assets/logo.png"
        WindowState="Maximized"
        Title="Nota">
  <Window.Resources>
    <app:ToolbarSideToAlignmentConverter x:Key="ToolbarSideToAlignment"/>
  </Window.Resources>
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="New" app:Commands.Id="file.new"/>
            <NativeMenuItem Header="Open…" app:Commands.Id="file.open"/>
            <NativeMenuItem Header="Save" app:Commands.Id="file.save"/>
            <NativeMenuItem Header="Save as…" app:Commands.Id="file.saveAs"/>
            <NativeMenuItem Header="Save version with note…" app:Commands.Id="file.saveVersion"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Import audio…" app:Commands.Id="file.import"/>
            <NativeMenuItem Header="Export audio…" app:Commands.Id="file.export"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Settings…" app:Commands.Id="prefs.open"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="Edit">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Undo" app:Commands.Id="edit.undo"/>
            <NativeMenuItem Header="Redo" app:Commands.Id="edit.redo"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Duplicate clip" app:Commands.Id="edit.duplicate"/>
            <NativeMenuItem Header="Insert scene" app:Commands.Id="session.insertScene"/>
            <NativeMenuItem Header="Split at playhead" app:Commands.Id="edit.split"/>
            <NativeMenuItem Header="Consolidate" app:Commands.Id="edit.consolidate"/>
            <NativeMenuItem Header="Duplicate time" app:Commands.Id="edit.duplicateTime"/>
            <NativeMenuItem Header="Insert silence" app:Commands.Id="edit.insertSilence"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Lock envelopes" app:Commands.Id="edit.lockEnvelopes" ToggleType="CheckBox"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Cut" app:Commands.Id="edit.cut"/>
            <NativeMenuItem Header="Copy" app:Commands.Id="edit.copy"/>
            <NativeMenuItem Header="Paste" app:Commands.Id="edit.paste"/>
            <NativeMenuItem Header="Paste bounced audio" app:Commands.Id="edit.pasteBounced"/>
            <NativeMenuItem Header="Copy clips to Session / Arrangement" app:Commands.Id="edit.copyToOtherView"/>
            <NativeMenuItem Header="Delete" app:Commands.Id="edit.delete"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Grid">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Narrow grid" app:Commands.Id="grid.narrower"/>
                  <NativeMenuItem Header="Widen grid" app:Commands.Id="grid.wider"/>
                  <NativeMenuItem Header="Triplet grid" app:Commands.Id="grid.triplets"/>
                  <NativeMenuItem Header="Snap to grid" app:Commands.Id="grid.snap"/>
                  <NativeMenuItem Header="Adaptive grid" app:Commands.Id="grid.adaptive"/>
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Command palette…" app:Commands.Id="view.palette"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Mixer" app:Commands.Id="view.mixer"/>
            <NativeMenuItem Header="Connect phone…" app:Commands.Id="view.connectPhone"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Toggle browser" app:Commands.Id="view.toggleBrowser"/>
            <NativeMenuItem Header="Toggle detail panel" app:Commands.Id="view.toggleDetail"/>
            <NativeMenuItem Header="Toggle overview" app:Commands.Id="view.toggleOverview"/>
            <NativeMenuItem Header="Toggle sections" app:Commands.Id="view.toggleSections"/>
            <NativeMenuItem Header="Toggle full screen" app:Commands.Id="view.fullscreen"/>
            <NativeMenuItemSeparator/>
            <!-- Header text is matched from code to keep this checkmark in step with the
                 transport bar's Follow button — see MainWindow.SetFollowPlayhead. -->
            <NativeMenuItem Header="Follow playhead" app:Commands.Id="view.follow" ToggleType="CheckBox"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Clip names" app:Commands.Id="view.clipNames"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="Transport">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Play / stop" app:Commands.Id="transport.playStop"/>
            <NativeMenuItem Header="Record" app:Commands.Id="transport.record"/>
            <NativeMenuItem Header="Loop" app:Commands.Id="transport.loop"/>
            <NativeMenuItem Header="Loop record: overdub / replace" app:Commands.Id="transport.loopRecordMode"/>
            <NativeMenuItem Header="Metronome" app:Commands.Id="transport.metronome"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="Help">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Documentation" app:Commands.Id="help.docs"/>
            <NativeMenuItem Header="What's new" app:Commands.Id="help.whatsNew"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="About Nota" app:Commands.Id="help.about"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Panel>
  <DockPanel Background="{DynamicResource Brush.Seam}">
    <!-- Header (32) on the ground, a seam under it — custom frameless: macOS traffic lights
         sit in the left inset; the project name is centred on the window. Draggable.
         (Transport sits right under it, at the top of the window.) -->
    <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="32"
            Background="{DynamicResource Brush.BgApp}"
            BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPressed">
      <Grid x:Name="TitleBarRow" ColumnDefinitions="78,*,Auto" Margin="0,0,12,0">
        <TextBlock x:Name="DocTitleText" Grid.Column="0" Grid.ColumnSpan="3" Text="Nota" Classes="Heading"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        </StackPanel>
      </Grid>
    </Border>

    <!-- In-window menu bar for Windows/Linux (empty on macOS: menus go to the system bar):
         a menubar-style row — the ground, with a seam under it. -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.BgApp}">
      <NativeMenuBar/>
    </Border>

    <!-- Transport (44) under the header, above the work area — a flat docked row on the
         panel tone with a seam under it. Stop / play / record, position and loop share one
         30px recessed group inside it, so playback reads as one object rather than a row of
         keys. Reads left to right as: which view · what plays · the numbers you set ·
         the switches you flip · then, pinned right, what the machine is doing. Launch
         quantize shows only in Session, where it applies. The view switch leads the row.
         When the window is too narrow the row sheds its least-needed parts first —
         see MainWindow.TransportFit.cs for the order. -->
    <Border x:Name="TransportBar" DockPanel.Dock="Top" Classes="transport" Height="{StaticResource Control.TransportBar}">
      <Grid x:Name="TransportGrid" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">

        <!-- Project name, then the view switch -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="2,0,10,0" VerticalAlignment="Center">
          <TextBlock x:Name="ProjectNameText" Text="Untitled" FontSize="13" FontWeight="SemiBold"
                     MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.TextPrimary}"/>
          <Border Classes="segmented" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="1">
              <!-- The views as icon keys (spec 012): the tooltip and the accessible name carry
                   the view name. View → Arrangement / Session / Modular do the same. -->
              <ToggleButton x:Name="ArrangeBtn" Classes="seg view" IsChecked="True" Click="OnShowArrangement"
                            ToolTip.Tip="Arrangement" AutomationProperties.Name="Arrangement">
                <app:Glyph Kind="Arrangement" Size="16"/>
              </ToggleButton>
              <ToggleButton x:Name="SessionBtn" Classes="seg view" Click="OnShowSession"
                            ToolTip.Tip="Session" AutomationProperties.Name="Session">
                <app:Glyph Kind="Session" Size="16"/>
              </ToggleButton>
              <ToggleButton x:Name="ModularBtn" Classes="seg view" Click="OnShowModular"
                            ToolTip.Tip="Modular" AutomationProperties.Name="Modular">
                <app:Glyph Kind="Modular" Size="16"/>
              </ToggleButton>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- The console: transport · position · loop in one recess -->
        <Border Grid.Column="1" Classes="console">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
              <!-- Shapes built from geometry: stop a square, play a filled triangle, record a
                   filled disc. No glyph font. Keys butt against each other on 1px seams. -->
              <Button x:Name="StopBtn" Classes="tp-icon" ToolTip.Tip="Stop (Return)"
                      Foreground="{DynamicResource Brush.TextStrong}" Command="{Binding Transport.StopCommand}">
                <app:Glyph x:Name="StopGlyph" Kind="Stop" Width="9" Height="9"/>
              </Button>
              <Button x:Name="PlayBtn" Classes="tp-play" ToolTip.Tip="Play (Space)"
                      Classes.playing="{Binding Transport.IsPlaying}" Command="{Binding Transport.PlayCommand}">
                <app:Glyph x:Name="PlayGlyph" Kind="Play" Width="10" Height="12" Margin="2,0,0,0"/>
              </Button>
              <ToggleButton x:Name="RecordBtn" Classes="tp-icon rec" ToolTip.Tip="Record (⌘R)"
                            IsChecked="{Binding Transport.RecordOn}">
                <app:Glyph x:Name="RecordGlyph" Kind="Record" Width="10" Height="10"/>
              </ToggleButton>
            </StackPanel>

            <Border Width="1" Height="18" Background="{DynamicResource Brush.Rule}"/>

            <!-- Position — click to flip bars.beats ↔ minutes:seconds; the unit beside says which -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Cursor="Hand" Background="Transparent"
                        PointerPressed="OnTogglePositionDisplay"
                        ToolTip.Tip="Switch between bars and time">
              <TextBlock Classes="Readout" Text="{Binding Transport.PositionText}" FontSize="14"
                         MinWidth="72" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}"/>
              <TextBlock Classes="CellLabel" Text="{Binding Transport.PositionUnitText}" VerticalAlignment="Center"/>
            </StackPanel>

            <Border x:Name="LoopSep" Width="1" Height="18" Background="{DynamicResource Brush.Rule}"/>

            <!-- Loop: the range is the key -->
            <ToggleButton x:Name="LoopCell" Classes="cell" Height="22" IsChecked="{Binding Transport.LoopOn}" ToolTip.Tip="Loop the range set on the ruler">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="CellLabel" Text="Loop" VerticalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}"/>
                <TextBlock Classes="Mono" FontSize="11" MinWidth="58" VerticalAlignment="Center"
                           Text="{Binding Transport.LoopRangeText}"
                           Foreground="{Binding $parent[ToggleButton].Foreground}"/>
              </StackPanel>
            </ToggleButton>
            <!-- Loop record mode: Overdub (rests neutral) or Replace (lit, the non-default choice) -->
            <ToggleButton x:Name="LoopRecordCell" Classes="cell" Height="22" IsChecked="{Binding Transport.LoopRecordReplace}"
                          ToolTip.Tip="Loop recording: Overdub adds every pass · Replace keeps the latest pass (⌘⇧R)">
              <Panel>
                <!-- Sizer: the cell keeps the longer label's width in both states, so the bar doesn't shift -->
                <TextBlock Classes="CellLabel" Text="Overdub" Opacity="0" VerticalAlignment="Center"/>
                <TextBlock Classes="CellLabel" Text="Overdub" VerticalAlignment="Center" HorizontalAlignment="Center"
                           IsVisible="{Binding !Transport.LoopRecordReplace}" Foreground="{Binding $parent[ToggleButton].Foreground}"/>
                <TextBlock Classes="CellLabel" Text="Replace" VerticalAlignment="Center" HorizontalAlignment="Center"
                           IsVisible="{Binding Transport.LoopRecordReplace}" Foreground="{Binding $parent[ToggleButton].Foreground}"/>
              </Panel>
            </ToggleButton>
          </StackPanel>
        </Border>

        <!-- Readouts: one 26px well each, a mono value and its muted unit on one line -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,0,0">
          <!-- Tempo (drag ↕ or double-click to type) -->
          <Border Classes="well" ToolTip.Tip="Set the tempo — drag, or double-click to type">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Panel x:Name="BpmHost" Width="52" Height="18" VerticalAlignment="Center"/>
              <TextBlock Classes="CellLabel" Text="BPM" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <!-- Tap tempo: fires on press (a release lags the beat). The dots count the beats
               of the current series, brass as each one lands; they clear when it times out. -->
          <Button x:Name="TapChip" Classes="cell" ClickMode="Press" Click="OnTapTempo"
                  ToolTip.Tip="Tap the beat to set the tempo">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <StackPanel x:Name="TapDots" Orientation="Horizontal" Spacing="3"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="4" Height="4" Fill="{DynamicResource Brush.BorderStrong}"/>
                <Ellipse Width="4" Height="4" Fill="{DynamicResource Brush.BorderStrong}"/>
                <Ellipse Width="4" Height="4" Fill="{DynamicResource Brush.BorderStrong}"/>
                <Ellipse Width="4" Height="4" Fill="{DynamicResource Brush.BorderStrong}"/>
              </StackPanel>
              <TextBlock Classes="CellLabel" Text="Tap" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <!-- Time signature (drag ↕ each field) -->
          <Border x:Name="TimeSigCell" Classes="well" ToolTip.Tip="Set the time signature — drag each field">
            <StackPanel Orientation="Horizontal" Spacing="1" Height="18" VerticalAlignment="Center">
              <Panel x:Name="TimeSigNumHost" Width="16"/>
              <TextBlock Classes="Mono" Text="/" FontSize="13" VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextMuted}"/>
              <Panel x:Name="TimeSigDenHost" Width="16"/>
            </StackPanel>
          </Border>
          <!-- Project key: loops dropped in can be transposed to it -->
          <Button x:Name="KeyChip" Classes="cell" Click="OnPickProjectKey" ToolTip.Tip="Set the project key — samples can be transposed to it">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock x:Name="KeyLabel" Classes="Mono" Text="—" FontSize="13"
                         MinWidth="30" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
              <TextBlock Classes="CellLabel" Text="Key" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <!-- Clip snap grid (SnapChip.cs): the step in effect, live with the zoom in Auto;
               click for the grid menu. SnapChip sizes the value to its widest label. -->
          <Button x:Name="SnapChip" Classes="cell">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock x:Name="SnapLabel" Classes="Mono" Text="1/4" FontSize="13"
                         MinWidth="36" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}"/>
              <TextBlock x:Name="SnapCaption" Classes="CellLabel" Text="Grid" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Switches. Each draws the thing it does, so the row carries no prose: a
             metronome, a magnet, a breakpoint envelope. None sets Foreground, so the
             engaged state fills the key with the accent and the glyph takes the derived ink
             through the base ToggleButton:checked. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="10,0,0,0">
          <!-- Metronome: body, pendulum rod, weight -->
          <ToggleButton x:Name="MetronomeBtn" Classes="tp-icon" IsChecked="{Binding Transport.MetronomeOn}"
                        ContextRequested="OnMetronomeContext"
                        ToolTip.Tip="Turn the metronome on or off (⌘M) · right-click for count-in">
            <app:Glyph Kind="Metronome" Size="15"/>
          </ToggleButton>
          <!-- Follow playhead: keep the arrangement scrolling with the cursor. The
               playhead marker standing on its ruler. A flag (block + point) rather than a
               bare triangle: at 15px a flat triangle over a stem reads as "⊥". Viewport
               brackets around it were tried too and collapse into noise at this size. Mirrored by View ▸ Follow playhead,
               which shares one code path. -->
          <ToggleButton x:Name="FollowBtn" Classes="tp-icon" Click="OnToggleFollow"
                        ToolTip.Tip="Scroll the arrangement to keep the playhead in view">
            <app:Glyph Kind="Follow" Size="15"/>
          </ToggleButton>
          <!-- Snapping on/off, independent of which grid the GRID cell shows. Off is the
               same as holding Alt, but latched. A horseshoe magnet: the poles are banded
               off the body by a transparent gap, so the shape reads on any button state. -->
          <ToggleButton x:Name="SnapToggle" Classes="tp-icon" IsChecked="True" Click="OnToggleSnapEnabled"
                        ToolTip.Tip="Snap clips to the grid (hold Alt to drag freely)">
            <app:Glyph Kind="Snap" Size="15"/>
          </ToggleButton>
          <!-- Automation: a breakpoint envelope — the ramp and handles the lanes draw -->
          <ToggleButton x:Name="AutomationToggle" Classes="tp-icon" Click="OnToggleAutomation">
            <app:Glyph Kind="Automation" Size="15"/>
          </ToggleButton>
          <!-- Shown only while a hand-moved control has taken a lane over from
               playback (M9-C); one click hands every overridden lane back. -->
          <Button x:Name="ReenableAutoBtn" Classes="chip" Content="Re-enable"
                  IsVisible="False" Click="OnReenableAutomation"
                  ToolTip.Tip="Hand overridden controls back to their automation"/>
        </StackPanel>

        <!-- Add track: one menu instead of three chips -->
        <!-- <Button Grid.Column="5" Classes="chip" Margin="12,0,0,0" ToolTip.Tip="Add a track"> -->
        <!--   <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"> -->
        <!--     <TextBlock Text="+ Track" VerticalAlignment="Center"/> -->
        <!--     <app:Glyph Kind="CaretDown" Size="9" Foreground="{DynamicResource Brush.TextTertiary}"/> -->
        <!--   </StackPanel> -->
        <!--   <Button.Flyout> -->
        <!--     <MenuFlyout Placement="BottomEdgeAlignedLeft"> -->
        <!--       <MenuItem Header="Instrument" Click="OnAddInstrumentClicked"/> -->
        <!--       <MenuItem Header="Audio" Click="OnAddAudioClicked"/> -->
        <!--       <MenuItem Header="Return" Click="OnAddReturnClicked"/> -->
        <!--     </MenuFlyout> -->
        <!--   </Button.Flyout> -->
        <!-- </Button> -->

        <!-- MIDI learn + an input-activity dot, so a silent controller is diagnosable;
             Remote (Nota Remote) beside it: off / the number of phones, a dot that flashes on
             each touch from a phone. Click opens Connect Phone. -->
        <StackPanel x:Name="RemotePanel" Grid.Column="6" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
          <ToggleButton x:Name="MidiLearnBtn" Classes="chip"
                        Click="OnToggleMidiLearn"
                        ToolTip.Tip="Map a controller — click a control, then move a knob on the controller">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="MIDI" VerticalAlignment="Center"
                         Foreground="{Binding $parent[ToggleButton].Foreground}"/>
              <Ellipse x:Name="MidiDot" Width="5" Height="5" VerticalAlignment="Center"
                       Fill="{DynamicResource Brush.BorderStrong}"/>
            </StackPanel>
          </ToggleButton>
          <Button x:Name="RemoteBtn" Classes="chip" Click="OnRemoteClick"
                  ToolTip.Tip="Play and control Nota from a phone">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <Border x:Name="RemoteGlyph" Width="8" Height="12" CornerRadius="{StaticResource Radius.Clip}" BorderThickness="1.5"
                      BorderBrush="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
              <TextBlock x:Name="RemoteLabel" Text="Remote" VerticalAlignment="Center"
                         Foreground="{Binding $parent[Button].Foreground}"/>
              <TextBlock x:Name="RemoteCount" Classes="Mono" Text="Off" FontSize="10" VerticalAlignment="Center"
                         Foreground="{Binding $parent[Button].Foreground}"/>
              <Ellipse x:Name="RemoteDot" Width="5" Height="5" VerticalAlignment="Center"
                       Fill="{DynamicResource Brush.BorderStrong}"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <Border x:Name="CpuSep" Grid.Column="7" Width="1" Height="18" Margin="10,0"
                Background="{DynamicResource Brush.Rule}"/>

        <!-- DSP load (audio-callback time ÷ buffer); the tooltip adds process CPU (MainWindow.SetUpCpuTip) -->
        <StackPanel x:Name="CpuMeter" Grid.Column="8" Spacing="3" VerticalAlignment="Center" Background="Transparent">
          <Border Width="52" Height="4" Background="{DynamicResource Brush.BgSunken}"
                  CornerRadius="{StaticResource Radius.Clip}" ClipToBounds="True">
            <Border x:Name="CpuFill" Width="0" HorizontalAlignment="Left" CornerRadius="{StaticResource Radius.Clip}"
                    Background="{DynamicResource Brush.Success}"/>
          </Border>
          <TextBlock x:Name="CpuText" Classes="Mono CellLabel" Text="DSP 0%" FontWeight="Normal"/>
        </StackPanel>

        <!-- Master: fader over its meter, with the gain in dB -->
        <Border x:Name="MasterWell" Grid.Column="9" Classes="tp-well" Margin="10,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="CellLabel" Text="Master" VerticalAlignment="Center"/>
            <StackPanel Spacing="3" VerticalAlignment="Center">
              <Panel x:Name="MasterVolHost" Width="88" Height="10"/>
              <Panel x:Name="MasterMeterHost" Width="88" Height="4"/>
            </StackPanel>
            <TextBlock Classes="Mono" FontSize="11" MinWidth="46" TextAlignment="Right"
                       VerticalAlignment="Center" Text="{Binding Transport.MasterDbText}"
                       Foreground="{DynamicResource Brush.TextPrimary}"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Status line (22): caption text on the ground, a seam above it. -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.BgApp}"
            BorderBrush="{DynamicResource Brush.Seam}" BorderThickness="0,1,0,0"
            Height="22" Padding="16,0">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <TextBlock Classes="Caption" VerticalAlignment="Center" Text="{Binding StatusText}"/>
        <!-- Settings → Downloads job (MainWindow.Downloads.cs): it keeps running after Settings closes. -->
        <Panel x:Name="DownloadHost" Grid.Column="1" VerticalAlignment="Center"/>
        <!-- Background-operation strip: label + thin bar, shown only while a background op runs. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="0,0,14,0"
                    IsVisible="{Binding BackgroundBusy}">
          <TextBlock Classes="Caption" VerticalAlignment="Center" Text="{Binding BackgroundLabel}"/>
          <ProgressBar Width="120" Height="4" VerticalAlignment="Center"
                       Minimum="0" Maximum="100"
                       Value="{Binding BackgroundProgress}"
                       IsIndeterminate="{Binding BackgroundIndeterminate}"
                       Foreground="{DynamicResource Brush.Accent}"
                       Background="{DynamicResource Brush.BgSunken}"/>
        </StackPanel>
        <TextBlock Grid.Column="3" Classes="Caption Mono"
                   VerticalAlignment="Center" Text="{Binding EngineInfo}"/>
        <!-- The installed version: opens its release notes (What's New), never an update (#127). -->
        <Button x:Name="VersionButton" Grid.Column="4" Classes="ghost"
                VerticalAlignment="Center" Margin="6,0,-6,0" Padding="6,1" MinHeight="0"
                Cursor="Hand" ToolTip.Tip="View release notes">
          <TextBlock x:Name="VersionText" Classes="Caption Mono"/>
        </Button>
      </Grid>
    </Border>


    <!-- Main area (fills) over a resizable bottom Detail panel, split by a
         draggable horizontal GridSplitter. -->
    <Grid x:Name="BodyGrid" Background="{DynamicResource Brush.Seam}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="120"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="0"/>
      </Grid.RowDefinitions>

      <!-- Left browser + main area (fills). Both are docked panels that meet on a 1px seam
           (the grid's seam-coloured ground showing through a 1px margin). The splitter takes
           no space of its own — it is a transparent 6px grab strip laid over the seam
           (negative margins; MinWidth=0 overrides the theme's 6px floor). -->
      <Grid x:Name="BrowserGrid" Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="344" MinWidth="160" MaxWidth="480"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <app:BrowserView x:Name="Browser" Grid.Column="0" Margin="0,0,1,0"/>
        <GridSplitter x:Name="BrowserSplitter" Grid.Column="1" Width="6" MinWidth="0" Margin="-4,0,-2,0"
                      Background="Transparent" ResizeDirection="Columns"/>
        <Panel x:Name="MainContent" Grid.Column="2">
          <app:ArrangementView x:Name="Timeline"/>
        </Panel>
      </Grid>

      <!-- Drag handle to resize the Detail panel (only shown when it is open). Like the
           browser splitter it is a 6px strip laid over the seam instead of adding height. -->
      <GridSplitter x:Name="DetailSplitter"
                    Grid.Row="1"
                    Height="6" MinHeight="0" Margin="0,-3,0,-3"
                    IsVisible="False"
                    HorizontalAlignment="Stretch" ResizeDirection="Rows"
                    Background="Transparent"/>

      <!-- Detail panel: Devices chain / Clip (piano roll) / Mixer for the selected track.
           Docked under the canvas on a seam, like the browser beside it. -->
      <Border x:Name="DetailPanel" Grid.Row="2" Margin="0,1,0,0" IsVisible="False" ClipToBounds="True"
              Background="{DynamicResource Brush.BgApp}" BorderThickness="0"
              CornerRadius="{StaticResource Radius.Docked}">
        <DockPanel>
          <!-- Panel toolbar (32, seam under it): mode tabs · track chip (routing/PDC) ·
               Freeze · | · pop out · close -->
          <Border DockPanel.Dock="Top" Height="32" Background="{DynamicResource Brush.Panel}"
                  BorderBrush="{DynamicResource Brush.Seam}" BorderThickness="0,0,0,1">
          <Grid Margin="8,0,6,0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
            <Border Classes="segmented" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="1">
                <ToggleButton x:Name="DetailDevicesBtn" Classes="seg" Content="Devices" Click="OnDetailDevices"/>
                <ToggleButton x:Name="DetailPatternBtn" Classes="seg" Content="Pattern" IsEnabled="False"
                              ToolTip.Tip="Step the selected MIDI clip on a Drum Rack track"
                              Click="OnDetailPattern"/>
                <ToggleButton x:Name="DetailClipBtn" Classes="seg" Content="Clip" IsEnabled="False"
                              ToolTip.Tip="Select a MIDI clip to edit it" Click="OnDetailClip"/>
              </StackPanel>
            </Border>
            <ContentControl x:Name="DetailChipHost" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button x:Name="FreezeBtn" Height="22" Padding="9,0" VerticalAlignment="Center"
                      Click="OnFreezeClick"
                      ToolTip.Tip="Freeze the track to audio to free CPU (right-click to flatten)">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <app:Glyph x:Name="FreezeIcon" Kind="Freeze" Foreground="{DynamicResource Brush.TextSecondary}"/>
                  <TextBlock x:Name="FreezeLabel" Text="Freeze" FontSize="12" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
              </Button>
              <Button x:Name="LiveFreezeBtn" Height="22" Padding="9,0" VerticalAlignment="Center"
                      IsVisible="False" Click="OnLiveFreezeClick"
                      ToolTip.Tip="Bounce to a linked audio track below and put the source to sleep">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <app:Glyph Kind="ChainLink" Size="14" Foreground="{DynamicResource Brush.TextSecondary}"/>
                  <TextBlock Text="Live freeze" FontSize="12" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
              </Button>
              <Button x:Name="EditBtn" Height="22" Padding="9,0" VerticalAlignment="Center"
                      IsVisible="False" Click="OnEditClick"
                      ToolTip.Tip="Wake the frozen source to edit it (right-click to unfreeze or flatten)">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <app:Glyph x:Name="EditGlyph" Kind="Edit" Foreground="{DynamicResource Brush.AccentBright}"/>
                  <TextBlock Text="Edit" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Brush.AccentBright}"/>
                </StackPanel>
              </Button>
              <Button x:Name="DoneBtn" Height="22" Padding="9,0" VerticalAlignment="Center"
                      IsVisible="False" Click="OnDoneClick"
                      ToolTip.Tip="Re-freeze the source and put it back to sleep">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <app:Glyph x:Name="DoneGlyph" Kind="Check" Foreground="{DynamicResource Brush.AccentBright}"/>
                  <TextBlock Text="Done" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Brush.AccentBright}"/>
                </StackPanel>
              </Button>
              <Button x:Name="DiscardBtn" Classes="ghost" Height="22" Padding="6,0" VerticalAlignment="Center"
                      IsVisible="False" Click="OnDiscardClick"
                      ToolTip.Tip="Leave edit mode without re-freezing">
                <app:Glyph x:Name="DiscardGlyph" Kind="Cross" Foreground="{DynamicResource Brush.TextTertiary}"/>
              </Button>
            </StackPanel>
            <Border Grid.Column="3" Width="1" Height="16" Margin="10,0,6,0" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Rule}"/>
            <Button x:Name="DetailPopOut" Grid.Column="4" Classes="ghost" Height="22" Padding="6,0"
                    Foreground="{DynamicResource Brush.TextTertiary}" Click="OnToggleDetailWindow"
                    ToolTip.Tip="Open devices and clip in a separate window">
              <app:Glyph x:Name="PopOutGlyph" Kind="PopOut"/>
            </Button>
            <Button Grid.Column="5" Classes="ghost" Height="22" Margin="2,0,0,0" Padding="6,0"
                    Foreground="{DynamicResource Brush.TextTertiary}" Click="OnCloseDetail" ToolTip.Tip="Close">
              <app:Glyph x:Name="CloseDetailGlyph" Kind="Close"/>
            </Button>
          </Grid>
          </Border>
          <ContentControl x:Name="DetailBody"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
    <!-- MIDI-learn glass: highlights mappable controls + captures the learn click. -->
    <app:MidiLearnOverlay x:Name="LearnOverlay" IsHitTestVisible="False"/>
    <!-- Command palette + its toast (MainWindow.Palette.cs); empty until ⌘⇧P. -->
    <Panel x:Name="PaletteLayer"/>
  </Panel>
</Window>
