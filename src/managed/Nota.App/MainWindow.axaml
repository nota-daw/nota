<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:Nota.App"
        xmlns:vm="clr-namespace:Nota.Presentation;assembly=Nota.Presentation"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
        x:Class="Nota.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200" Height="800" MinWidth="1100" MinHeight="680"
        Background="{DynamicResource Brush.BgApp}"
        Icon="/Assets/logo.png"
        WindowState="Maximized"
        Title="Nota">
  <Window.Resources>
    <app:ToolbarSideToAlignmentConverter x:Key="ToolbarSideToAlignment"/>
  </Window.Resources>
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="New" Click="OnMenuNew" Gesture="Cmd+N"/>
            <NativeMenuItem Header="Open…" Click="OnMenuOpen" Gesture="Cmd+O"/>
            <NativeMenuItem Header="Save" Click="OnMenuSave" Gesture="Cmd+S"/>
            <NativeMenuItem Header="Save As…" Click="OnMenuSaveAs" Gesture="Shift+Cmd+S"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Import audio…" Click="OnMenuImport" Gesture="Cmd+I"/>
            <NativeMenuItem Header="Export audio…" Click="OnMenuExport" Gesture="Shift+Cmd+E"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Settings…" Click="OnPreferences" Gesture="Ctrl+,"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="Edit">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Undo" Click="OnMenuUndo" Gesture="Cmd+Z"/>
            <NativeMenuItem Header="Redo" Click="OnMenuRedo" Gesture="Shift+Cmd+Z"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Duplicate clip" Click="OnMenuDuplicate" Gesture="Cmd+D"/>
            <NativeMenuItem Header="Split at playhead" Click="OnMenuSplit" Gesture="Cmd+E"/>
            <NativeMenuItem Header="Consolidate" Click="OnMenuConsolidate" Gesture="Cmd+J"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Lock Envelopes" Click="OnToggleLockEnvelopes" ToggleType="CheckBox"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Cut" Click="OnMenuCut"/>
            <NativeMenuItem Header="Copy" Click="OnMenuCopy"/>
            <NativeMenuItem Header="Paste" Click="OnMenuPaste"/>
            <NativeMenuItem Header="Delete" Click="OnMenuDeleteSel"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Mixer" Click="OnMenuMixer" Gesture="Cmd+M"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Toggle browser" Click="OnMenuToggleBrowser"/>
            <NativeMenuItem Header="Toggle detail panel" Click="OnMenuToggleClip"/>
            <NativeMenuItem Header="Toggle overview" Click="OnMenuToggleOverview"/>
            <NativeMenuItem Header="Toggle sections" Click="OnMenuToggleSections"/>
            <NativeMenuItemSeparator/>
            <!-- Header text is matched from code to keep this checkmark in step with the
                 transport bar's Follow button — see MainWindow.SetFollowPlayhead. -->
            <NativeMenuItem Header="Follow playhead" Click="OnMenuToggleFollow" ToggleType="CheckBox"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Clip names" Click="OnMenuCycleClipNames"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="Transport">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Play / Stop" Click="OnMenuPlayStop"/>
            <NativeMenuItem Header="Record" Click="OnMenuRecord"/>
            <NativeMenuItem Header="Loop" Click="OnMenuLoop" Gesture="Cmd+L"/>
            <NativeMenuItem Header="Metronome" Click="OnMenuMetronome" Gesture="Cmd+K"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="Help">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="What's New" Click="OnWhatsNew"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="About Nota" Click="OnAbout"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Panel>
  <DockPanel>
    <!-- Header (36) — custom frameless: macOS traffic lights sit in the left inset;
         the project name is centred on the window. Draggable.
         (Transport sits right under it, at the top of the window.) -->
    <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="36"
            Background="{DynamicResource Brush.ChromeBg}"
            BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPressed">
      <Grid x:Name="TitleBarRow" ColumnDefinitions="78,*,Auto" Margin="0,0,12,0">
        <TextBlock x:Name="DocTitleText" Grid.Column="0" Grid.ColumnSpan="3" Text="Nota" Classes="Heading"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        </StackPanel>
      </Grid>
    </Border>

    <!-- In-window menu bar for Windows/Linux (empty on macOS: menus go to the system bar) -->
    <NativeMenuBar DockPanel.Dock="Top"/>

    <!-- Transport (42) under the header, above the work area. The whole strip is one
         recess on Void, so buttons, position, tempo and loop read as one object rather
         than a row of buttons. Reads left to right as: which view · what plays · the numbers you set ·
         the switches you flip · then, pinned right, what the machine is doing. Launch
         quantize shows only in Session, where it applies. The view switch leads the row. -->
    <Border x:Name="TransportBar" DockPanel.Dock="Top" Classes="transport" Height="{StaticResource Control.Console}" Padding="10,0">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">

        <!-- View switch -->
        <Border Grid.Column="0" Classes="segmented" Margin="0,0,12,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <ToggleButton x:Name="ArrangeBtn" Classes="seg" Content="Arrangement" IsChecked="True" Click="OnShowArrangement"/>
            <ToggleButton x:Name="SessionBtn" Classes="seg" Content="Session" Click="OnShowSession"/>
            <ToggleButton x:Name="ModularBtn" Classes="seg" Content="Modular" Click="OnShowModular"/>
          </StackPanel>
        </Border>

        <!-- The console: transport · position · loop in one recess -->
        <Border Grid.Column="1" Classes="console">
          <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <!-- Shapes built from geometry (almanac): stop a 10px square r1, play an 11×14
                   triangle, record an 11px disc. No glyph font. -->
              <Button x:Name="StopBtn" Classes="tp-icon" ToolTip.Tip="Stop"
                      Foreground="{DynamicResource Brush.TextStrong}" Command="{Binding Transport.StopCommand}">
                <app:Glyph x:Name="StopGlyph" Kind="Stop"/>
              </Button>
              <Button x:Name="PlayBtn" Classes="tp-play" ToolTip.Tip="Play"
                      Foreground="{DynamicResource Brush.TextOnAccent}" Command="{Binding Transport.PlayCommand}">
                <app:Glyph x:Name="PlayGlyph" Kind="Play" Margin="2,0,0,0"/>
              </Button>
              <ToggleButton x:Name="RecordBtn" Classes="tp-icon rec" ToolTip.Tip="Record"
                            IsChecked="{Binding Transport.RecordOn}">
                <app:Glyph x:Name="RecordGlyph" Kind="Record"/>
              </ToggleButton>
            </StackPanel>

            <Border Width="1" Height="24" Background="{DynamicResource Brush.BorderDefault}"/>

            <!-- Position — click to flip bars.beats ↔ minutes:seconds; the unit below says which -->
            <StackPanel Spacing="1" VerticalAlignment="Center" Cursor="Hand" Background="Transparent"
                        PointerPressed="OnTogglePositionDisplay"
                        ToolTip.Tip="Switch between bars and time">
              <TextBlock Classes="Readout" Text="{Binding Transport.PositionText}" LineHeight="16"
                         MinWidth="72" Foreground="{DynamicResource Brush.AccentBright}"/>
              <TextBlock Classes="CellLabel" Text="{Binding Transport.PositionUnitText}"/>
            </StackPanel>

            <Border Width="1" Height="24" Background="{DynamicResource Brush.BorderDefault}"/>

            <!-- Loop: the range is the button -->
            <ToggleButton Classes="cell" IsChecked="{Binding Transport.LoopOn}" ToolTip.Tip="Loop the range set on the ruler">
              <StackPanel Spacing="2">
                <TextBlock Classes="CellLabel" Text="LOOP" Foreground="{Binding $parent[ToggleButton].Foreground}"/>
                <TextBlock Classes="Mono" FontSize="11" LineHeight="12" MinWidth="58"
                           Text="{Binding Transport.LoopRangeText}"
                           Foreground="{Binding $parent[ToggleButton].Foreground}"/>
              </StackPanel>
            </ToggleButton>
          </StackPanel>
        </Border>

        <!-- Readouts: value over label, one shape for all of them -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="12,0,0,0">
          <!-- Tempo (drag ↕ or double-click to type) -->
          <StackPanel Spacing="2" VerticalAlignment="Center" Margin="7,0" ToolTip.Tip="Set the tempo — drag, or double-click to type">
            <Panel x:Name="BpmHost" Width="52" Height="18"/>
            <TextBlock Classes="CellLabel" Text="BPM" HorizontalAlignment="Center"/>
          </StackPanel>
          <!-- Time signature (drag ↕ each field) -->
          <StackPanel Spacing="2" VerticalAlignment="Center" Margin="7,0" ToolTip.Tip="Set the time signature — drag each field">
            <StackPanel Orientation="Horizontal" Spacing="1" Height="18">
              <Panel x:Name="TimeSigNumHost" Width="16"/>
              <TextBlock Classes="Mono" Text="/" FontSize="14" VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextTertiary}"/>
              <Panel x:Name="TimeSigDenHost" Width="16"/>
            </StackPanel>
            <TextBlock Classes="CellLabel" Text="SIG" HorizontalAlignment="Center"/>
          </StackPanel>
          <!-- Clip snap grid: click to cycle -->
          <Button x:Name="SnapChip" Classes="cell" Click="OnCycleSnap" ToolTip.Tip="Cycle the clip snap grid">
            <StackPanel Spacing="2">
              <TextBlock x:Name="SnapLabel" Classes="Mono" Text="1/4" FontSize="14" LineHeight="16"
                         MinWidth="36" TextAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}"/>
              <TextBlock Classes="CellLabel" Text="GRID" HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>
          <!-- Launch quantize — a Session concept, so it only appears there -->
          <Button x:Name="LaunchQChip" Classes="cell" Click="OnCycleLaunchQ" IsVisible="False"
                  ToolTip.Tip="Set when Session slots and scenes launch">
            <StackPanel Spacing="2">
              <TextBlock x:Name="LaunchQLabel" Classes="Mono" Text="1 Bar" FontSize="14" LineHeight="16"
                         MinWidth="44" TextAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}"/>
              <TextBlock Classes="CellLabel" Text="LAUNCH" HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Switches. Each draws the thing it does, so the row carries no prose: a
             metronome, a magnet, a breakpoint envelope. None sets Foreground, so the
             engaged state turns the glyph brass through the base ToggleButton:checked. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="12,0,0,0">
          <!-- Metronome: body, pendulum rod, weight -->
          <ToggleButton Classes="tp-icon" IsChecked="{Binding Transport.MetronomeOn}" ToolTip.Tip="Turn the metronome on or off (M)">
            <Viewbox Width="15" Height="15">
              <Canvas Width="24" Height="24">
                <Path Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.7"
                      StrokeJoin="Round" Data="M9.8 5.5 H14.2 L19 20 H5 Z"/>
                <Path Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.7"
                      StrokeLineCap="Round" Data="M12 19 L13.9 3.2"/>
                <Ellipse Canvas.Left="11.33" Canvas.Top="9.4" Width="3.2" Height="3.2"
                         Fill="{Binding $parent[ToggleButton].Foreground}"/>
              </Canvas>
            </Viewbox>
          </ToggleButton>
          <!-- Follow playhead: keep the arrangement scrolling with the cursor. The
               playhead marker standing on its ruler. A flag (block + point) rather than a
               bare triangle: at 15px a flat triangle over a stem reads as "⊥". Viewport
               brackets around it were tried too and collapse into noise at this size. Mirrored by View ▸ Follow playhead,
               which shares one code path. -->
          <ToggleButton x:Name="FollowBtn" Classes="tp-icon" Click="OnToggleFollow"
                        ToolTip.Tip="Scroll the arrangement to keep the playhead in view">
            <Viewbox Width="15" Height="15">
              <Canvas Width="24" Height="24">
                <Path Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.7"
                      StrokeLineCap="Round" Data="M3.5 17.8 H20.5"/>
                <Path Fill="{Binding $parent[ToggleButton].Foreground}" Data="M6.5 5 H12.5 V9 L9.5 12.5 L6.5 9 Z"/>
                <Path Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.7"
                      StrokeLineCap="Round" Data="M9.5 12.5 V17.8"/>
              </Canvas>
            </Viewbox>
          </ToggleButton>
          <!-- Snapping on/off, independent of which grid the GRID cell shows. Off is the
               same as holding Alt, but latched. A horseshoe magnet: the poles are banded
               off the body by a transparent gap, so the shape reads on any button state. -->
          <ToggleButton x:Name="SnapToggle" Classes="tp-icon" IsChecked="True" Click="OnToggleSnapEnabled"
                        ToolTip.Tip="Snap clips to the grid (hold Alt to drag freely)">
            <Viewbox Width="15" Height="15">
              <Canvas Width="24" Height="24">
                <Path Fill="{Binding $parent[ToggleButton].Foreground}"
                      Data="M4 17 V12.5 A8 8 0 0 1 20 12.5 V17 H15.5 V12.5 A3.5 3.5 0 0 0 8.5 12.5 V17 Z"/>
                <Rectangle Canvas.Left="4" Canvas.Top="19" Width="4.5" Height="2.5"
                           Fill="{Binding $parent[ToggleButton].Foreground}"/>
                <Rectangle Canvas.Left="15.5" Canvas.Top="19" Width="4.5" Height="2.5"
                           Fill="{Binding $parent[ToggleButton].Foreground}"/>
              </Canvas>
            </Viewbox>
          </ToggleButton>
          <!-- Automation: a breakpoint envelope — the ramp and handles the lanes draw -->
          <ToggleButton x:Name="AutomationToggle" Classes="tp-icon" Click="OnToggleAutomation"
                        ToolTip.Tip="Show parameter-automation lanes (⌘A)">
            <Viewbox Width="15" Height="15">
              <Canvas Width="24" Height="24">
                <Path Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.8"
                      StrokeLineCap="Round" StrokeJoin="Round" Data="M3 17.5 H9 L14.5 7.5 H21"/>
                <Ellipse Canvas.Left="7.1" Canvas.Top="15.6" Width="3.8" Height="3.8"
                         Fill="{Binding $parent[ToggleButton].Foreground}"/>
                <Ellipse Canvas.Left="12.6" Canvas.Top="5.6" Width="3.8" Height="3.8"
                         Fill="{Binding $parent[ToggleButton].Foreground}"/>
              </Canvas>
            </Viewbox>
          </ToggleButton>
          <!-- Shown only while a hand-moved control has taken a lane over from
               playback (M9-C); one click hands every overridden lane back. -->
          <Button x:Name="ReenableAutoBtn" Classes="chip" Content="Re-enable"
                  IsVisible="False" Click="OnReenableAutomation"
                  Foreground="{DynamicResource Brush.AccentBright}"
                  ToolTip.Tip="Hand overridden controls back to their automation"/>
        </StackPanel>

        <!-- Add track: one menu instead of three chips -->
        <!-- <Button Grid.Column="5" Classes="chip" Margin="12,0,0,0" ToolTip.Tip="Add a track"> -->
        <!--   <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"> -->
        <!--     <TextBlock Text="+ Track" VerticalAlignment="Center"/> -->
        <!--     <Path Data="M0,0 L3.5,4 L7,0 Z" Fill="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center"/> -->
        <!--   </StackPanel> -->
        <!--   <Button.Flyout> -->
        <!--     <MenuFlyout Placement="BottomEdgeAlignedLeft"> -->
        <!--       <MenuItem Header="Instrument" Click="OnAddInstrumentClicked"/> -->
        <!--       <MenuItem Header="Audio" Click="OnAddAudioClicked"/> -->
        <!--       <MenuItem Header="Return" Click="OnAddReturnClicked"/> -->
        <!--     </MenuFlyout> -->
        <!--   </Button.Flyout> -->
        <!-- </Button> -->

        <!-- MIDI learn + an input-activity dot, so a silent controller is diagnosable -->
        <ToggleButton Grid.Column="6" x:Name="MidiLearnBtn" Classes="chip" Margin="8,0,0,0"
                      Click="OnToggleMidiLearn"
                      ToolTip.Tip="Map a controller — click a control, then move a knob on the controller">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="MIDI" VerticalAlignment="Center"
                       Foreground="{Binding $parent[ToggleButton].Foreground}"/>
            <Ellipse x:Name="MidiDot" Width="5" Height="5" VerticalAlignment="Center"
                     Fill="{DynamicResource Brush.BorderStrong}"/>
          </StackPanel>
        </ToggleButton>

        <Border Grid.Column="7" Width="1" Height="26" Margin="14,0"
                Background="{DynamicResource Brush.BorderDefault}"/>

        <!-- CPU: live DSP load -->
        <StackPanel Grid.Column="8" Spacing="3" VerticalAlignment="Center">
          <Border Width="52" Height="4" Background="{DynamicResource Brush.SurfaceAbyss}"
                  CornerRadius="2" ClipToBounds="True">
            <Border x:Name="CpuFill" Width="0" HorizontalAlignment="Left" CornerRadius="2"
                    Background="{DynamicResource Brush.Success}"/>
          </Border>
          <TextBlock x:Name="CpuText" Classes="Mono CellLabel" Text="CPU 0%" FontWeight="Normal"/>
        </StackPanel>

        <!-- Master: fader over its meter, with the gain in dB -->
        <Border Grid.Column="9" Height="{StaticResource Control.Transport}" Margin="12,0,0,0" Padding="10,0"
                Background="{DynamicResource Brush.BgSunken}" CornerRadius="{StaticResource Radius.Tile}"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <TextBlock Classes="CellLabel" Text="MST" VerticalAlignment="Center"/>
            <StackPanel Spacing="3" VerticalAlignment="Center">
              <Panel x:Name="MasterVolHost" Width="88" Height="12"/>
              <Panel x:Name="MasterMeterHost" Width="88" Height="5"/>
            </StackPanel>
            <TextBlock Classes="Mono" FontSize="10" MinWidth="46" TextAlignment="Right"
                       VerticalAlignment="Center" Text="{Binding Transport.MasterDbText}"
                       Foreground="{DynamicResource Brush.TextSecondary}"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Status bar (22) -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.ChromeBg}"
            BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="0,1,0,0"
            Height="22" Padding="12,0">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Classes="Caption" VerticalAlignment="Center" Text="{Binding StatusText}"/>
        <!-- Background-operation strip: label + thin bar, shown only while a background op runs. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="0,0,14,0"
                    IsVisible="{Binding BackgroundBusy}">
          <TextBlock Classes="Caption" VerticalAlignment="Center" Text="{Binding BackgroundLabel}"/>
          <ProgressBar Width="120" Height="4" VerticalAlignment="Center"
                       Minimum="0" Maximum="100"
                       Value="{Binding BackgroundProgress}"
                       IsIndeterminate="{Binding BackgroundIndeterminate}"
                       Foreground="{DynamicResource Brush.Accent}"
                       Background="{DynamicResource Brush.BorderDefault}"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Classes="Caption Mono"
                   VerticalAlignment="Center" Text="{Binding EngineInfo}"/>
      </Grid>
    </Border>


    <!-- Main area (fills) over a resizable bottom Detail panel, split by a
         draggable horizontal GridSplitter. -->
    <Grid x:Name="BodyGrid" Background="{DynamicResource Brush.Gutter}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="120"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="0"/>
      </Grid.RowDefinitions>

      <!-- Left browser (240) + main area (fills). Browser and arrangement are both islands:
           they float on the app ground with an even gutter, so the splitter between them
           carries no line of its own — it is a 2px transparent grab strip inside that gutter. -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="288" MinWidth="160" MaxWidth="480"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <app:BrowserView x:Name="Browser" Grid.Column="0" Margin="12,12,10,12"/>
        <GridSplitter Grid.Column="1" Width="2" Background="Transparent"
                      ResizeDirection="Columns"/>
        <Panel x:Name="MainContent" Grid.Column="2">
          <app:ArrangementView x:Name="Timeline" Margin="0,12,12,12"/>
        </Panel>
      </Grid>

      <!-- Drag handle to resize the Detail panel (only shown when it is open). -->
      <GridSplitter x:Name="DetailSplitter"
                    Grid.Row="1"
                    Height="2"
                    IsVisible="False"
                    HorizontalAlignment="Stretch" ResizeDirection="Rows"
                    Background="Transparent"/>

      <!-- Detail panel: Devices chain / Clip (piano roll) / Mixer for the selected track -->
      <Border x:Name="DetailPanel" Grid.Row="2" Classes="Panel"
              IsVisible="False" Background="{DynamicResource Brush.Panel}">
        <DockPanel>
          <!-- Header (1d/1e): mode tabs · track chip (routing/PDC) · Freeze · close -->
          <Grid DockPanel.Dock="Top" Height="34" Margin="12,0" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <Border Classes="segmented" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <ToggleButton x:Name="DetailDevicesBtn" Classes="seg" Content="Devices" Click="OnDetailDevices"/>
                <ToggleButton x:Name="DetailPatternBtn" Classes="seg" Content="Pattern" IsEnabled="False"
                              ToolTip.Tip="Step the selected MIDI clip on a Drum Rack track"
                              Click="OnDetailPattern"/>
                <ToggleButton x:Name="DetailClipBtn" Classes="seg" Content="Clip" IsEnabled="False"
                              ToolTip.Tip="Select a MIDI clip to edit it" Click="OnDetailClip"/>
              </StackPanel>
            </Border>
            <ContentControl x:Name="DetailChipHost" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button x:Name="FreezeBtn" Classes="ghost" Height="24" Padding="8,0" VerticalAlignment="Center"
                      Click="OnFreezeClick"
                      ToolTip.Tip="Freeze the track to audio to free CPU (right-click to flatten)">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <app:Glyph x:Name="FreezeIcon" Kind="Freeze" Foreground="{DynamicResource Brush.TextSecondary}"/>
                  <TextBlock x:Name="FreezeLabel" Text="Freeze" FontSize="11" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
              </Button>
              <Button x:Name="LiveFreezeBtn" Classes="ghost" Height="24" Padding="8,0" VerticalAlignment="Center"
                      IsVisible="False" Click="OnLiveFreezeClick"
                      ToolTip.Tip="Bounce to a linked audio track below and put the source to sleep">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Path Width="14" Height="14" Stretch="None" StrokeThickness="1.4"
                        Stroke="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"
                        Data="{x:Static app:NotaIcons.ChainLink}"/>
                  <TextBlock Text="Live Freeze" FontSize="11" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
              </Button>
              <Button x:Name="EditBtn" Classes="ghost" Height="24" Padding="8,0" VerticalAlignment="Center"
                      IsVisible="False" Click="OnEditClick"
                      ToolTip.Tip="Wake the frozen source to edit it (right-click to unfreeze or flatten)">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <app:Glyph x:Name="EditGlyph" Kind="Edit" Foreground="{DynamicResource Brush.AccentBright}"/>
                  <TextBlock Text="Edit" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Brush.AccentBright}"/>
                </StackPanel>
              </Button>
              <Button x:Name="DoneBtn" Classes="ghost" Height="24" Padding="8,0" VerticalAlignment="Center"
                      IsVisible="False" Click="OnDoneClick"
                      ToolTip.Tip="Re-freeze the source and put it back to sleep">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <app:Glyph x:Name="DoneGlyph" Kind="Check" Foreground="{DynamicResource Brush.AccentBright}"/>
                  <TextBlock Text="Done" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Brush.AccentBright}"/>
                </StackPanel>
              </Button>
              <Button x:Name="DiscardBtn" Classes="ghost" Height="24" Padding="6,0" VerticalAlignment="Center"
                      IsVisible="False" Click="OnDiscardClick"
                      ToolTip.Tip="Leave edit mode without re-freezing">
                <app:Glyph x:Name="DiscardGlyph" Kind="Cross" Foreground="{DynamicResource Brush.TextTertiary}"/>
              </Button>
            </StackPanel>
            <Button x:Name="DetailPopOut" Grid.Column="3" Classes="ghost" Margin="8,0,0,0" Padding="7,0"
                    Foreground="{DynamicResource Brush.TextTertiary}" Click="OnToggleDetailWindow"
                    ToolTip.Tip="Open devices and clip in a separate window">
              <app:Glyph x:Name="PopOutGlyph" Kind="PopOut"/>
            </Button>
            <Button Grid.Column="4" Classes="ghost" Margin="4,0,0,0" Padding="7,0"
                    Foreground="{DynamicResource Brush.TextTertiary}" Click="OnCloseDetail" ToolTip.Tip="Close">
              <app:Glyph x:Name="CloseDetailGlyph" Kind="Close"/>
            </Button>
          </Grid>
          <ContentControl x:Name="DetailBody"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
    <!-- MIDI-learn glass: highlights mappable controls + captures the learn click. -->
    <app:MidiLearnOverlay x:Name="LearnOverlay" IsHitTestVisible="False"/>
  </Panel>
</Window>
