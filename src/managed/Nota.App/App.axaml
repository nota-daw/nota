<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nota.App.App"
             Name="Nota"
             RequestedThemeVariant="Dark">
             <!-- Dark is the default; App.OnFrameworkInitializationCompleted hands the
                  real choice (Preferences → Appearance) to NotaThemeService before the
                  first window paints. See .claude/skills/nota-design. -->

    <!-- macOS application menu (the bold "Nota" menu). Avalonia puts every item of the
         Application's NativeMenu straight into the app menu, above Services / Hide / Quit,
         so About, Check for updates and Settings are listed directly — wrapping them in a "Nota" item would
         nest them in a submenu (#160). Windows/Linux don't show this menu. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Nota" Click="OnAppAbout"/>
            <NativeMenuItem Header="Check for updates…" Click="OnAppCheckUpdates"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Settings…" Click="OnAppPreferences" Gesture="Cmd+,"/>
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Nota.App/Theme/NotaTheme.axaml"/>
    </Application.Styles>
</Application>