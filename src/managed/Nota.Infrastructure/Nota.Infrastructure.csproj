<!-- Infrastructure layer: P/Invoke (interop), persistence, settings, audio/midi config.
     Implements the Application ports. Depends on Application + Domain. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nota.Application\Nota.Application.csproj" />
    <ProjectReference Include="..\Nota.Domain\Nota.Domain.csproj" />
  </ItemGroup>

  <!-- Engine contract types (NotaNote, NotaTrackInfo, …) and ports live in the
       Application namespace; make them ambient so the P/Invoke layer and services
       reference them by simple name. -->
  <ItemGroup>
    <Using Include="Nota.Application" />
  </ItemGroup>

  <!-- The smoke test checks the AI models' DSP ports (DemucsSpec, Resampler, basic-pitch
       decoding) against golden output from the Python originals. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Nota.SmokeTest" />
  </ItemGroup>

  <!-- ONNX Runtime's managed half only: the native library is downloaded with the first AI
       model (ModelStore / OnnxRuntimeLoader), so the installer doesn't carry it. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.23.2" />
  </ItemGroup>

</Project>
